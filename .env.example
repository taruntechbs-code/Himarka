# ==============================================================================
# HIMARKA System Environment Configuration Example
# Solar-Powered Smart Mini Cold Storage System
# IMPORTANT: Copy this file to .env and fill in real values. NEVER commit .env.
# ==============================================================================

# Application General
APP_NAME=HIMARKA
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# Backend API Server
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Database Configuration (PostgreSQL in production; SQLite allowed for local dev)
DATABASE_URL=postgresql+asyncpg://himarka_user:himarka_pass@localhost:5432/himarka_db
# For lightweight local dev without PostgreSQL:
# DATABASE_URL=sqlite+aiosqlite:///./himarka_dev.db

# Authentication / Security
SECRET_KEY=replace_with_a_secure_random_64_byte_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Firebase Integration (Optional adapter layer - credentials kept server-side)
FIREBASE_PROJECT_ID=himarka-storage-dev
FIREBASE_DATABASE_URL=https://himarka-storage-dev-default-rtdb.firebaseio.com
FIREBASE_CREDENTIALS_PATH=./secrets/firebase-adminsdk-placeholder.json

# IoT Device Ingestion Security
IOT_DEVICE_SHARED_SECRET=replace_with_device_psk_secret
IOT_MAX_CLOCK_SKEW_SECONDS=300

# AI / Intelligence Layer
GEMINI_API_KEY=replace_with_gemini_api_key_server_side_only
AI_MODEL_REGISTRY_DIR=./ai/models/registry
AI_CHECKPOINTS_DIR=./ai/models/checkpoints

# Frontend Environment Variables (Safe for public exposure)
VITE_APP_NAME=HIMARKA
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_ENV=development
VITE_DEFAULT_LOCALE=en
